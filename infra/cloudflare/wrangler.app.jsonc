{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edsync-dev",
  "main": "../../.open-next/worker.js",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "../../.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "edsync-dev"
    }
  ],
  "vars": {
    "DEPLOYMENT_TARGET": "cloudflare",
    "NEXT_PUBLIC_THEME_DEFAULT": "light",
    "EMAIL_MODE": "outbox",
    "PAYMENT_PROVIDER": "manual",
    "TENANT_ROUTING_MODE": "hybrid",
    "DEFAULT_TENANT_SLUG": "edsync",
    "NEXT_PUBLIC_PWA_ENABLED": "true",
    "CLOUDFLARE_D1_DATABASE_NAME": "edsync-dev-d1",
    "CLOUDFLARE_D1_DATABASE_ID": "54bbff25-6efb-4210-8c3a-e9ac0e2a0a98",
    "R2_BUCKET": "edsync-assets-dev",
    "R2_PUBLIC_BASE_URL": "https://pub-648d4acbbaac4a3e96a5dea072706010.r2.dev",
    "NEXT_PUBLIC_R2_PUBLIC_BASE_URL": "https://pub-648d4acbbaac4a3e96a5dea072706010.r2.dev",
    "NEXT_PUBLIC_APP_URL": "https://edsync-dev.learn-app.workers.dev",
    "CLOUDFLARE_QUEUE_NAME": "edsync-automation-dev",
    "CLOUDFLARE_VECTORIZE_INDEX": "edsync-learning-dev",
    "CLOUDFLARE_PAGES_PROJECT": "edsync"
  },
  "d1_databases": [
    {
      "binding": "EDSYNC_DB",
      "database_name": "edsync-dev-d1",
      "database_id": "54bbff25-6efb-4210-8c3a-e9ac0e2a0a98"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EDSYNC_ASSETS",
      "bucket_name": "edsync-assets-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EDSYNC_QUEUE",
        "queue": "edsync-automation-dev"
      }
    ]
  },
  "vectorize": [
    {
      "binding": "EDSYNC_VECTORIZE",
      "index_name": "edsync-learning-dev"
    }
  ],
  "env": {
    "preview": {
      "name": "edsync-preview",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "edsync-preview"
        }
      ],
      "vars": {
        "DEPLOYMENT_TARGET": "cloudflare",
        "NEXT_PUBLIC_THEME_DEFAULT": "light",
        "EMAIL_MODE": "outbox",
        "PAYMENT_PROVIDER": "manual",
        "TENANT_ROUTING_MODE": "hybrid",
        "DEFAULT_TENANT_SLUG": "edsync",
        "NEXT_PUBLIC_PWA_ENABLED": "true",
        "CLOUDFLARE_D1_DATABASE_NAME": "edsync-preview-d1",
        "CLOUDFLARE_D1_DATABASE_ID": "6ae1887c-2efb-4199-89c2-2d68ef7b3ce2",
        "R2_BUCKET": "edsync-assets-preview",
        "R2_PUBLIC_BASE_URL": "https://pub-83c176f255cf44ada09ff54097705245.r2.dev",
        "NEXT_PUBLIC_R2_PUBLIC_BASE_URL": "https://pub-83c176f255cf44ada09ff54097705245.r2.dev",
        "NEXT_PUBLIC_APP_URL": "https://edsync-preview.learn-app.workers.dev",
        "CLOUDFLARE_QUEUE_NAME": "edsync-automation-preview",
        "CLOUDFLARE_VECTORIZE_INDEX": "edsync-learning-preview",
        "CLOUDFLARE_PAGES_PROJECT": "edsync"
      },
      "d1_databases": [
        {
          "binding": "EDSYNC_DB",
          "database_name": "edsync-preview-d1",
          "database_id": "6ae1887c-2efb-4199-89c2-2d68ef7b3ce2"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EDSYNC_ASSETS",
          "bucket_name": "edsync-assets-preview"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EDSYNC_QUEUE",
            "queue": "edsync-automation-preview"
          }
        ]
      },
      "vectorize": [
        {
          "binding": "EDSYNC_VECTORIZE",
          "index_name": "edsync-learning-preview"
        }
      ]
    },
    "production": {
      "name": "edsync",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "edsync"
        }
      ],
      "vars": {
        "DEPLOYMENT_TARGET": "cloudflare",
        "NEXT_PUBLIC_THEME_DEFAULT": "light",
        "EMAIL_MODE": "outbox",
        "PAYMENT_PROVIDER": "manual",
        "TENANT_ROUTING_MODE": "hybrid",
        "DEFAULT_TENANT_SLUG": "edsync",
        "NEXT_PUBLIC_PWA_ENABLED": "true",
        "CLOUDFLARE_D1_DATABASE_NAME": "edsync-prod-d1",
        "CLOUDFLARE_D1_DATABASE_ID": "cfa252cc-750f-4aaa-8e3a-624cbe56e6bd",
        "R2_BUCKET": "edsync-assets-prod",
        "R2_PUBLIC_BASE_URL": "https://pub-fd59bf7992c64c6f94c13d2aedc47a83.r2.dev",
        "NEXT_PUBLIC_R2_PUBLIC_BASE_URL": "https://pub-fd59bf7992c64c6f94c13d2aedc47a83.r2.dev",
        "NEXT_PUBLIC_APP_URL": "https://edsync.learn-app.workers.dev",
        "CLOUDFLARE_QUEUE_NAME": "edsync-automation-prod",
        "CLOUDFLARE_VECTORIZE_INDEX": "edsync-learning-prod",
        "CLOUDFLARE_PAGES_PROJECT": "edsync"
      },
      "d1_databases": [
        {
          "binding": "EDSYNC_DB",
          "database_name": "edsync-prod-d1",
          "database_id": "cfa252cc-750f-4aaa-8e3a-624cbe56e6bd"
        }
      ],
      "r2_buckets": [
        {
          "binding": "EDSYNC_ASSETS",
          "bucket_name": "edsync-assets-prod"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EDSYNC_QUEUE",
            "queue": "edsync-automation-prod"
          }
        ]
      },
      "vectorize": [
        {
          "binding": "EDSYNC_VECTORIZE",
          "index_name": "edsync-learning-prod"
        }
      ]
    }
  }
}
