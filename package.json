{
  "name": "edsync-learning-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "check:extraction": "node scripts/check-extraction-bounds.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "build:cloudflare": "opennextjs-cloudflare build --config wrangler.app.jsonc",
    "preview:cloudflare": "opennextjs-cloudflare build --config wrangler.app.jsonc && opennextjs-cloudflare preview --config wrangler.app.jsonc",
    "deploy:cloudflare:app": "opennextjs-cloudflare build --config wrangler.app.jsonc && opennextjs-cloudflare deploy --config wrangler.app.jsonc -- --keep-vars",
    "deploy:cloudflare:worker": "wrangler deploy --config wrangler.toml",
    "db:migrate": "node scripts/d1-migrate.mjs",
    "db:seed": "node scripts/d1-migrate.mjs --seed",
    "admin:create": "node scripts/create-admin.mjs",
    "ai:seed": "node scripts/seed-ai-providers.mjs",
    "security:cloudflare": "node scripts/cloudflare-security.mjs",
    "db:local": "docker compose -f docker-compose.local.yml up -d",
    "db:local:down": "docker compose -f docker-compose.local.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.14.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@opennextjs/cloudflare": "^1.14.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5",
    "wrangler": "^4.14.4"
  }
}
