{
  "name": "edsync-learning-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "check:extraction": "node scripts/check-extraction-bounds.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "build:cloudflare": "opennextjs-cloudflare build --config wrangler.app.jsonc",
    "preview:cloudflare": "opennextjs-cloudflare build --config wrangler.app.jsonc && opennextjs-cloudflare preview --config wrangler.app.jsonc",
    "deploy:cloudflare:app": "opennextjs-cloudflare build --config wrangler.app.jsonc && opennextjs-cloudflare deploy --config wrangler.app.jsonc -- --keep-vars",
    "deploy:cloudflare:worker": "wrangler deploy --config wrangler.toml",
    "db:migrate": "node scripts/d1-migrate.mjs",
    "db:seed": "node scripts/d1-migrate.mjs --seed",
    "admin:create": "node scripts/create-admin.mjs",
    "ai:seed": "node scripts/seed-ai-providers.mjs",
    "security:cloudflare": "node scripts/cloudflare-security.mjs",
    "db:local": "docker compose -f docker-compose.local.yml up -d",
    "db:local:down": "docker compose -f docker-compose.local.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/extension-character-count": "^3.23.4",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-font-family": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-typography": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.469.0",
    "next": "^14.2.35",
    "pptxgenjs": "^4.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.14.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@opennextjs/cloudflare": "^1.14.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "wrangler": "^4.14.4"
  }
}
