{
  "name": "edsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --config config/eslint/eslint.config.mjs src scripts config",
    "test": "vitest run --config config/test/vitest.config.ts --passWithNoTests",
    "test:watch": "vitest --config config/test/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm audit --audit-level=moderate && npm run build",
    "clean:local": "tsx scripts/maintenance/clean-local.ts",
    "clean:all": "tsx scripts/maintenance/clean-local.ts --include-node-modules",
    "check:extraction": "tsx scripts/maintenance/check-extraction-bounds.ts",
    "deploy:vercel": "tsx scripts/deploy/vercel.ts",
    "deploy:cloudflare": "tsx scripts/deploy/cloudflare.ts",
    "build:cloudflare": "opennextjs-cloudflare build --config infra/cloudflare/wrangler.app.jsonc",
    "preview:cloudflare": "opennextjs-cloudflare build --config infra/cloudflare/wrangler.app.jsonc && opennextjs-cloudflare preview --config infra/cloudflare/wrangler.app.jsonc",
    "deploy:cloudflare:app": "opennextjs-cloudflare build --config infra/cloudflare/wrangler.app.jsonc && opennextjs-cloudflare deploy --config infra/cloudflare/wrangler.app.jsonc --env production -- --keep-vars",
    "deploy:cloudflare:worker": "wrangler deploy --config infra/cloudflare/wrangler.toml",
    "db:migrate": "tsx scripts/database/d1-migrate.ts",
    "db:seed": "tsx scripts/database/d1-migrate.ts --seed",
    "admin:create": "tsx scripts/admin/create-admin.ts",
    "ai:seed": "tsx scripts/database/seed-ai-providers.ts",
    "security:cloudflare": "tsx scripts/deploy/cloudflare-security.ts",
    "db:migrate:dry-run": "tsx scripts/database/d1-migrate.ts --dry-run",
    "db:local": "docker compose -f infra/local/docker-compose.yml up -d",
    "db:local:down": "docker compose -f infra/local/docker-compose.yml down"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@tanstack/react-virtual": "^3.13.26",
    "@tiptap/extension-character-count": "^3.23.6",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-font-family": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
