{
  "name": "edsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --config config/eslint/eslint.config.mjs src ops config",
    "test": "vitest run --config config/test/vitest.config.ts --passWithNoTests",
    "test:watch": "vitest --config config/test/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:root && npm run check:folders && npm run check:artifacts && npm run check:typescript && npm run check:boundaries && npm run check:scripts && npm run check:ci && npm run check:cloudflare && npm run check:assets && npm run check:deps && npm run check:docs && npm run typecheck && npm run lint && npm run test && npm audit --audit-level=moderate && npm run build",
    "check:root": "tsx ops/scripts/maintenance/check-root-layout.ts",
    "check:folders": "tsx ops/scripts/maintenance/check-folder-organization.ts",
    "check:artifacts": "tsx ops/scripts/maintenance/check-tracked-artifacts.ts",
    "check:typescript": "tsx ops/scripts/maintenance/check-typescript-sources.ts",
    "check:boundaries": "tsx ops/scripts/maintenance/check-source-boundaries.ts",
    "check:scripts": "tsx ops/scripts/maintenance/check-script-targets.ts",
    "check:ci": "tsx ops/scripts/maintenance/check-ci-workflows.ts",
    "check:cloudflare": "tsx ops/scripts/maintenance/check-cloudflare-resources.ts",
    "check:assets": "tsx ops/scripts/maintenance/check-public-assets.ts",
    "check:deps": "tsx ops/scripts/maintenance/check-dependencies.ts",
    "check:docs": "tsx ops/scripts/maintenance/check-docs.ts",
    "check:local-routes": "tsx ops/scripts/maintenance/check-local-routes.ts",
    "clean:local": "tsx ops/scripts/maintenance/clean-local.ts",
    "clean:all": "tsx ops/scripts/maintenance/clean-local.ts --include-node-modules",
    "check:extraction": "tsx ops/scripts/maintenance/check-extraction-bounds.ts",
    "deploy:vercel": "tsx ops/scripts/deploy/vercel.ts",
    "deploy:cloudflare": "tsx ops/scripts/deploy/cloudflare.ts",
    "build:cloudflare": "opennextjs-cloudflare build --config infra/cloudflare/wrangler.app.jsonc --openNextConfigPath infra/cloudflare/open-next.config.ts",
    "preview:cloudflare": "opennextjs-cloudflare build --config infra/cloudflare/wrangler.app.jsonc --openNextConfigPath infra/cloudflare/open-next.config.ts && opennextjs-cloudflare preview --config infra/cloudflare/wrangler.app.jsonc",
    "deploy:cloudflare:app": "opennextjs-cloudflare build --config infra/cloudflare/wrangler.app.jsonc --openNextConfigPath infra/cloudflare/open-next.config.ts && opennextjs-cloudflare deploy --config infra/cloudflare/wrangler.app.jsonc -- --keep-vars",
    "db:migrate": "tsx ops/scripts/database/d1-migrate.ts",
    "db:seed": "tsx ops/scripts/database/d1-migrate.ts --seed",
    "admin:create": "tsx ops/scripts/admin/create-admin.ts",
    "ai:seed": "tsx ops/scripts/database/seed-ai-providers.ts",
    "security:cloudflare": "tsx ops/scripts/deploy/cloudflare-security.ts",
    "db:migrate:dry-run": "tsx ops/scripts/database/d1-migrate.ts --dry-run",
    "db:local": "docker compose -f infra/local/docker-compose.yml up -d",
    "db:local:down": "docker compose -f infra/local/docker-compose.yml down"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@tanstack/react-virtual": "^3.13.26",
    "@tiptap/core": "3.26.0",
    "@tiptap/extension-character-count": "3.26.0",
    "@tiptap/extension-color": "3.26.0",
    "@tiptap/extension-font-family": "3.26.0",
    "@tiptap/extension-highlight": "3.26.0",
    "@tiptap/extension-image": "3.26.0",
    "@tiptap/extension-link": "3.26.0",
    "@tiptap/extension-placeholder": "3.26.0",
    "@tiptap/extension-table": "3.26.0",
    "@tiptap/extension-table-cell": "3.26.0",
    "@tiptap/extension-table-header": "3.26.0",
    "@tiptap/extension-table-row": "3.26.0",
    "@tiptap/extension-task-item": "3.26.0",
    "@tiptap/extension-task-list": "3.26.0",
    "@tiptap/extension-text-align": "3.26.0",
    "@tiptap/extension-text-style": "3.26.0",
    "@tiptap/extension-typography": "3.26.0",
    "@tiptap/extension-underline": "3.26.0",
    "@tiptap/extensions": "3.26.0",
    "@tiptap/pm": "3.26.0",
    "@tiptap/react": "3.26.0",
    "@tiptap/starter-kit": "3.26.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260603.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.5.20",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
