# EdSync app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase hosted project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AI provider, compatible with the Business OS env pattern.
# Keep real values in .env.local and Vercel Project Settings only.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b:free
OPENROUTER_LESSON_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TUTOR_MODEL=openai/gpt-oss-120b:free
OPENROUTER_ANALYTICS_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TRANSLATION_MODEL=openai/gpt-oss-120b:free

# Cloudflare platform integration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=edsync.example.com
CLOUDFLARE_PAGES_PROJECT=edsync-learning-os
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_VECTORIZE_INDEX=edsync-learning-index
CLOUDFLARE_QUEUE_NAME=edsync-automation-queue
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cloudflare R2 object storage for uploads, generated assets, exports, and locale packs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edsync-assets
R2_PUBLIC_BASE_URL=https://assets.edsync.example.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=edsync-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local self-hosting/Postgres migration path
POSTGRES_DB=edsync
POSTGRES_USER=edsync
POSTGRES_PASSWORD=edsync_dev_password
DATABASE_URL=postgres://edsync:edsync_dev_password@localhost:54322/edsync

# Self-hosted runtime profile
DEPLOYMENT_TARGET=local
OBJECT_STORAGE_DRIVER=r2
AI_GATEWAY_DRIVER=cloudflare
TRANSLATION_BUNDLE_PATH=locales

# Vercel CLI automation
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
