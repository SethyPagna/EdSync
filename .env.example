# EdSync app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_THEME_DEFAULT=light

# Cloudflare D1 database. Use separate EdSync databases; do not reuse AllChess or LEARN resources.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=edsync-dev-d1

# Cloudflare platform services
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=edsync.example.com
CLOUDFLARE_PAGES_PROJECT=EdSync
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_VECTORIZE_INDEX=edsync-learning-dev
CLOUDFLARE_QUEUE_NAME=edsync-automation-dev
CLOUDFLARE_ENABLE_CONTENT_SCAN_RULES=false

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional malware scanning webhook. Local signature checks still run without this.
MALWARE_SCAN_ENDPOINT=
MALWARE_SCAN_TOKEN=
MALWARE_SCAN_FAIL_CLOSED=false

# Cloudflare R2 object storage. Use a dedicated EdSync bucket.
R2_BUCKET=edsync-assets-dev
R2_PUBLIC_BASE_URL=https://assets.edsync.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Authentication
SESSION_SECRET=replace-with-a-long-random-string

# Email delivery. Without RESEND_API_KEY, EdSync stores messages in the D1 outbox for review/retry.
RESEND_API_KEY=
EMAIL_FROM=EdSync <notifications@edsync.example.com>

# AI provider routed through Cloudflare AI Gateway when CLOUDFLARE_AI_GATEWAY_URL is set.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b:free
OPENROUTER_LESSON_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TUTOR_MODEL=openai/gpt-oss-120b:free
OPENROUTER_ANALYTICS_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TRANSLATION_MODEL=openai/gpt-oss-120b:free

# Runtime profile
DEPLOYMENT_TARGET=local
TRANSLATION_BUNDLE_PATH=locales

# Vercel CLI automation
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
